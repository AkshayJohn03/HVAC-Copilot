# hvac-copilot configuration example.
# Copy to `.env` and fill in only what you need. With everything commented out
# the system runs fully offline against deterministic mocks (default mode).

# --- LLM (OpenAI-compatible endpoint) ---------------------------------------
# Providers: mock (default, offline) | openai (any OpenAI-compatible API)
HVAC_LLM_PROVIDER=mock
# HVAC_LLM_API_KEY=sk-...
# HVAC_LLM_BASE_URL=https://api.openai.com/v1
# HVAC_LLM_MODEL=gpt-4o-mini
# HVAC_LLM_TEMPERATURE=0.1

# --- VLM (photo / nameplate reading) ----------------------------------------
# HVAC_VLM_PROVIDER=mock
# HVAC_VLM_API_KEY=sk-...
# HVAC_VLM_BASE_URL=https://api.openai.com/v1
# HVAC_VLM_MODEL=gpt-4o-mini

# --- Embeddings ---------------------------------------------------------------
# Providers: local-hash (default, deterministic offline hashing embedder)
#            | openai (text-embedding endpoint)
HVAC_EMBEDDING_PROVIDER=local-hash
# HVAC_EMBEDDING_API_KEY=sk-...
# HVAC_EMBEDDING_BASE_URL=https://api.openai.com/v1
# HVAC_EMBEDDING_MODEL=text-embedding-3-small
# HVAC_EMBEDDING_DIM=384

# --- Paths --------------------------------------------------------------------
# HVAC_CORPUS_DIR=corpus
# HVAC_INDEX_DIR=.index
# HVAC_GOLDEN_PATH=data/qa_golden.jsonl

# --- Retrieval tuning ----------------------------------------------------------
# HVAC_TOP_K=5
# HVAC_BM25_K1=1.5
# HVAC_BM25_B=0.75
# HVAC_RRF_K=60
# HVAC_RERANKER=bm25            # bm25 | cross-encoder | none
# HVAC_MMR_LAMBDA=0.0           # 0 disables MMR diversity

# --- Guardrail ------------------------------------------------------------------
# HVAC_GUARDRAIL_ENABLED=true

# --- Query cache ----------------------------------------------------------------
# HVAC_QUERY_CACHE_SIZE=256
# HVAC_SEMANTIC_CACHE_THRESHOLD=0.93

# --- Serving / auth --------------------------------------------------------------
# Comma-separated RAW API keys. When set, all /query* and /ingest routes require
# the X-API-Key header (health/metrics exempt). Only SHA-256 hashes are stored.
# Unset = auth disabled with a startup warning. NEVER log raw keys.
# HVAC_API_KEYS=key-one,key-two
